# Sanity project that backs the public Drive Boundless site
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=2025-05-16
# Only needed once write operations (status changes, vehicle edits, etc.) are added
SANITY_API_WRITE_TOKEN=

# Migration-only: used once by `pnpm seed-admin-user` to create the first appUser
# document in Sanity from your existing admin credentials. Not read at login time —
# once seeded, all accounts (admin and, later, owners) live in Sanity, managed from
# Settings > Team. Generate a hash with: pnpm hash-password "your password"
# Next.js expands $-prefixed sequences in .env files, and bcrypt hashes are full of "$" -
# escape every "$" as "\$" or the hash will silently fail to match.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random 32+ character string used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Base URL of this admin app, used to build links in outgoing emails (no trailing slash)
APP_URL=http://localhost:3000

# Resend (https://resend.com) — used for new-application alerts and sending agreements
# to customers. Until RESEND_FROM_EMAIL's domain is verified in Resend, leave it unset
# to fall back to Resend's shared sandbox sender (onboarding@resend.dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared secret for the Sanity webhook that triggers new-application alert emails.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Enter the same value when creating the webhook at sanity.io/manage — see the Stage 5
# setup notes for the exact webhook configuration.
SANITY_WEBHOOK_SECRET=
